# 새 Key를 로컬 .env에만 입력하고 Git이나 채팅에 공유하지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17

# 현재 단일 평가 대상인 OpenAI 호환 API
OPENAI_BASE_URL2=
OPENAI_API_KEY2=
OPENAI_MODEL2=

OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
OLLAMA_QWEN_MODEL=qwen2.5:3b

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_LLAMA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_GEMMA_MODEL=google/gemma-4-31b-it
NVIDIA_TIMEOUT=360
NVIDIA_MAX_TOKENS=1024
NVIDIA_TEMPERATURE=0.2
NVIDIA_TOP_P=0.7
NVIDIA_GEMMA_MAX_TOKENS=1024
NVIDIA_GEMMA_TEMPERATURE=1.0
NVIDIA_GEMMA_TOP_P=0.95

PROVIDER_RETRIES=1
PROVIDER_RETRY_DELAY_SECONDS=2
