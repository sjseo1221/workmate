{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workmate.example.com/schemas/a2a-artifact-1.0.json",
  "title": "Workmate A2A Artifact 1.0",
  "description": "Workmate MVP에서 사용하는 A2A Artifact와 Text/Data Part 계약",
  "$ref": "#/$defs/Artifact",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "TextPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "mediaType"],
      "properties": {
        "text": { "type": "string" },
        "mediaType": {
          "enum": ["text/markdown", "text/plain"]
        }
      }
    },
    "DataPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "mediaType"],
      "properties": {
        "data": { "type": "object" },
        "mediaType": { "const": "application/json" }
      }
    },
    "ArtifactPart": {
      "oneOf": [
        { "$ref": "#/$defs/TextPart" },
        { "$ref": "#/$defs/DataPart" }
      ]
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "name", "description", "parts"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/Identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ArtifactPart" }
        }
      }
    }
  }
}
