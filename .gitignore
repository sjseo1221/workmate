# 폐기된 로컬 UI 샘플
/workmate-ui-demo/

# Secret과 로컬 인증 자료
**/.env
**/.env.*
!**/.env.example
**/client_secret*.json
**/credentials*.json
**/token.json
**/token.json.*
**/*.pem
**/*.key

# 로컬 실행 환경과 생성물
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/node_modules/
**/.next/
**/*.log
**/*.tar
**/results/*.db
**/.runtime/
/main_agent.db

# Git에 저장하지 않는 원본 미디어
**/*.wav
**/*.mp3
**/*.m4a
**/*.webm
**/*.ogg

# 로컬 화면 캡처용 OIDC 발급기와 기동 로그 — 커밋하지 않는다.
# .local-dev/ 안에는 RSA 개인키와 발급된 JWT가 들어 있다.
.local-dev/
.agent.log
.agent.err.log
.oidc.log
.oidc.err.log
.ui.log
.ui.err.log

# 포트폴리오 PDF는 문서에서 다시 내보낼 수 있는 산출물이다
Workmate-AI-portfolio*.pdf
